MONGODB_URI=mongodb://127.0.0.1:27017/sidequest_dev
MONGODB_DB_NAME=sidequest_dev
HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
# Set SESSION_SECRET to at least 32 random bytes to enable password authentication.
# GOOGLE_CLIENT_ID is optional and additionally enables Google sign-in.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
# Shared limit on non-GET /api requests per signed-in user (or per IP when signed out).
WRITE_RATE_LIMIT_MAX=300
WRITE_RATE_LIMIT_WINDOW_MINUTES=15
# IGDB game import (npm run import:games in server/). Create a Twitch app at dev.twitch.tv/console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
