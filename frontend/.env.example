# Optional public Google web client ID override. When empty, Vite reuses
# GOOGLE_CLIENT_ID from the project root .env (never SESSION_SECRET).
VITE_GOOGLE_CLIENT_ID=
# Empty uses same-origin /api (Vite proxies locally; production needs a reverse proxy).
VITE_API_BASE_URL=
# Development-only proxy target; never exposed to the browser.
API_PROXY_TARGET=http://localhost:5000
